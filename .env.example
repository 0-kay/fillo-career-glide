# TypeSafe System One (Jev) — used by the ai-* edge functions and apps/api.
# Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Which provider the ai-* functions use.
#   typesafe → TypeSafe only (default)
#   openai   → legacy OpenAI prompt-and-parse only
#   ab       → run both, serve TypeSafe, log the disagreement
AI_PROVIDER=typesafe

# Legacy OpenAI path. Only required when AI_PROVIDER is `openai` or `ab`.
OPENAI_API_KEY=

# Used by apps/api to verify the caller's Supabase session. Supabase edge functions
# receive SUPABASE_URL and SUPABASE_ANON_KEY automatically, so nothing to set there.
SUPABASE_URL=
SUPABASE_ANON_KEY=
